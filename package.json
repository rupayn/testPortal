{
  "name": "testPortal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "seed": "turbo run seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker": "docker compose -f ./infra/docker/docker-compose.dev.yml up",
    "check-api": "turbo run format:check lint check-types --filter=api",
    "check-web": "turbo run format:check lint check-types --filter=web",
    "push-git": "node ./scripts/git-push.js"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
